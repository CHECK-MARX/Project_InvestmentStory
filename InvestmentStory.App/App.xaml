<Application x:Class="InvestmentStory.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <sys:Double x:Key="UiGridRowHeight">42</sys:Double>
            <sys:Double x:Key="UiGridHeaderHeight">42</sys:Double>
            <sys:Double x:Key="UiInputHeight">34</sys:Double>
            <sys:Double x:Key="UiFontSize">13</sys:Double>
            <sys:Double x:Key="UiSectionTitleFontSize">20</sys:Double>
            <sys:Double x:Key="UiLabelFontSize">13</sys:Double>
            <sys:Double x:Key="UiMetricValueFontSize">28</sys:Double>
            <sys:Double x:Key="UiSubtleFontSize">12</sys:Double>
            <Style TargetType="Window">
                <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="Styles/CardStyles.xaml" />
                <ResourceDictionary Source="Styles/DataGridStyles.xaml" />
                <ResourceDictionary Source="Styles/NavigationStyles.xaml" />
                <ResourceDictionary Source="Styles/InputStyles.xaml" />
                <ResourceDictionary Source="Styles/BadgeStyles.xaml" />
                <ResourceDictionary Source="Styles/ChartStyles.xaml" />
                <ResourceDictionary Source="Styles/ToolTipStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
