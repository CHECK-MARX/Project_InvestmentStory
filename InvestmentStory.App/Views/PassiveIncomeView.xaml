<UserControl x:Class="InvestmentStory.App.Views.PassiveIncomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:InvestmentStory.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="不労所得サマリー" Style="{StaticResource SectionTitleStyle}" />
            <UniformGrid Columns="4">
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="今月の不労所得" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ThisMonthPassiveIncome}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="今年の不労所得" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ThisYearPassiveIncome}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="今日以降の予定配当（年内・概算）" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ThisYearPlannedIncome}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="年初からの実績＋今日以降の予定" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ThisYearForecastIncludingPlanned}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="現在の保有株の年間配当換算（概算）" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AnnualPassiveIncomeForecast}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="月平均不労所得見込み（概算）" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MonthlyAveragePassiveIncome}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="1日あたり不労所得" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding DailyPassiveIncome}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="年間目標達成率" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding AnnualGoalAchievementRate}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="月間目標達成率" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding MonthlyGoalAchievementRate}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="年間目標まであといくら" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding AnnualGoalGap}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="外国税（今年実績・判明分）" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ForeignTaxActual}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="国内税（今年実績・判明分）" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding DomesticTaxActual}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="NISA配当（今年実績）" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding NisaDividendActual}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="課税配当（今年実績）" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding TaxableDividendActual}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="国内株配当（今年実績）" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding DomesticStockDividendActual}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="外国株配当（今年実績）" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ForeignStockDividendActual}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="月10万円まであといくら" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding GapToMonthly100k}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding PastDueWarning}" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="8,0,8,14" />
            <TextBlock Text="{Binding TaxDataNote}" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="8,0,8,10" />

            <StackPanel Margin="0,8,0,16">
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="今年の月別配当（1～12月）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel Margin="0,8,0,2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                <Border Width="20" Height="3" Background="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="今年の入金実績（実線）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                <Border Width="20" Height="3" Background="{DynamicResource DividendBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="見込み（実績＋予定・破線）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                <Border Width="20" Height="3" Background="{DynamicResource NeutralBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="前年同月の入金実績（一点鎖線）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                <Border Width="20" Height="3" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="月間目標（点線）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding MonthlyBreakdownAsOf}"
                                   Margin="0,2,0,6" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="記録のない月は線をつながず、表に『記録なし』と表示します。グラフをクリック後、左右キーで月を選択できます。" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <controls:MonthlyDividendLineChartControl Items="{Binding MonthlyBreakdownRows}" Height="340"
                                                                  AutomationProperties.Name="月別配当の折れ線グラフ" />
                        <Expander Header="月別の数値を表で確認" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding MonthlyBreakdownRows}" Height="250" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="月" Binding="{Binding Label}" Width="55" />
                                    <DataGridTextColumn Header="今年の入金実績" Binding="{Binding Actual}" Width="*" />
                                    <DataGridTextColumn Header="入金予定" Binding="{Binding Planned}" Width="*" />
                                    <DataGridTextColumn Header="見込み" Binding="{Binding Forecast}" Width="*" />
                                    <DataGridTextColumn Header="前年実績" Binding="{Binding PreviousYear}" Width="*" />
                                    <DataGridTextColumn Header="月間目標" Binding="{Binding Goal}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="年別配当グラフ" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="緑：各年の入金実績（税引後）" Margin="0,6,0,0" Style="{StaticResource SubtleTextStyle}" />
                        <ItemsControl ItemsSource="{Binding YearlyBars}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6" ToolTip="{Binding ToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Grid Grid.Column="1" Height="20" Background="{DynamicResource ElevatedSurfaceBrush}" VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" Background="{DynamicResource ProfitBrush}" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding AmountJpy}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox DockPanel.Dock="Right"
                                      ItemsSource="{Binding RankingModes}"
                                      SelectedItem="{Binding SelectedRankingMode, Mode=TwoWay}"
                                      Width="220" />
                            <TextBlock Text="{Binding RankingTitle}" Style="{StaticResource SectionTitleStyle}" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding DividendRankingRows}" Height="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="54" />
                                <DataGridTextColumn Header="コード" Binding="{Binding Ticker}" Width="90" />
                                <DataGridTextColumn Header="銘柄" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="金額" Binding="{Binding AmountJpy}" Width="130" />
                                <DataGridTextColumn Header="利回り/成長率" Binding="{Binding Rate}" Width="130" />
                                <DataGridTextColumn Header="構成比" Binding="{Binding ShareOfTotal}" Width="100" />
                                <DataGridTextColumn Header="前年差" Binding="{Binding PreviousYearDifference}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="目標情報" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding GoalMessage}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="対象年" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding TargetYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        <TextBlock Text="年間不労所得目標" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding AnnualPassiveIncomeGoal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        <TextBlock Text="月間不労所得目標" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding MonthlyPassiveIncomeGoal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        <TextBlock Text="総資産目標" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding TotalAssetGoal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        <Button Content="目標を保存" Command="{Binding SaveGoalCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
