<UserControl x:Class="InvestmentStory.App.Views.StockDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:InvestmentStory.App.Controls">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTicker}" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HeaderName}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding HeaderBroker}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="{Binding DetailScope}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="{Binding PositionBreakdown}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReferenceCostNote}" ToolTip="{Binding ReferenceCostSource}"
                               Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding CurrentPriceLabel}" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding CurrentPrice}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="評価額" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding CurrentMarketValueJpy}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="含み損益" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding UnrealizedGainJpy}" FontSize="22" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPositiveGain}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ProfitBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasNegativeGain}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource LossBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding UnrealizedGainRateJpy}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{Binding HeaderIncomeLabel}" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding HeaderIncomeValue}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                    <TextBlock Text="{Binding HeaderIncomeSubValue}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource MetricCardStyle}">
            <TabControl>
                <TabItem Header="概要">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,16,4,4">
                            <UniformGrid Columns="4" Visibility="{Binding MutualFundDetailVisibility}">
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="保有口数" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundUnitsHeld}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="取得単価" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundAverageCostNav}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="基準価額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundCurrentNav}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="評価損益率" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundUnrealizedGainLossRate}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ProfitBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="取得金額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundAcquisitionAmount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="評価額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundMarketValue}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="評価損益" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundUnrealizedGainLoss}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ProfitBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="分配金受取方法" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundDistributionMethod}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="基準価額更新日" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundNavDate}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="基準価額取得元" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundNavSource}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="累計売却額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundTotalSaleAmount}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="トータルリターン" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding FundTotalReturn}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ProfitBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Columns="4" Visibility="{Binding StockDetailVisibility}">
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="購入総額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding PurchaseTotalJpy}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="実質取得単価" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding EffectiveAcquisitionPrice}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="現在利回り" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding CurrentDividendYield}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="何倍になったか" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding Multiple}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="投資ストーリー" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,12" />
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                                <TextBlock Text="{Binding Story}" TextWrapping="Wrap" FontSize="15" LineHeight="25" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="価格・損益">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,16,4,4">
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="外貨ベース評価額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding CurrentMarketValueUsd}" FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="外貨ベース含み損益" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding UnrealizedGainUsd}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ProfitBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="為替影響額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding CurrencyImpactJpy}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Style="{StaticResource MetricCardStyle}" MinHeight="520">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PriceChartTitle}"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,8" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ChartPeriods}"
                                                  SelectedItem="{Binding SelectedChartPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="120"
                                                  Margin="0,0,10,8" />
                                        <Button Grid.Column="2"
                                                Content="チャート更新"
                                                Command="{Binding RefreshPriceChartCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,12,8" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PriceChartStatus}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                    </Grid>
                                    <controls:PriceChartControl Grid.Row="1"
                                                                MinHeight="430"
                                                                Points="{Binding PriceChartPoints}"
                                                                CurrentPrice="{Binding ChartCurrentPriceValue}"
                                                                AverageCost="{Binding ChartAverageCostValue}"
                                                                Currency="{Binding ChartCurrency}"
                                                                LineOnly="{Binding IsPriceChartLineOnly}"
                                                                StatusMessage="{Binding PriceChartStatus}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="配当">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="3" Margin="4,16,4,4">
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="年間配当" Style="{StaticResource LabelTextStyle}" />
                                    <TextBlock Text="{Binding AnnualDividend}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="月平均配当" Style="{StaticResource LabelTextStyle}" />
                                    <TextBlock Text="{Binding MonthlyDividendJpy}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="取得額ベース利回り" Style="{StaticResource LabelTextStyle}" />
                                    <TextBlock Text="{Binding YieldOnCost}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="取引履歴">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,16,4,4">
                            <UniformGrid Columns="6">
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="累計買付額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding TotalBuyAmountJpy}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="累計売却額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding TotalSaleAmountJpy}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="現在数量" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding CurrentTradeQuantity}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="平均取得単価" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding AverageTradeCost}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="実現損益" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding RealizedGainLossJpy}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ProfitBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="取引件数" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding TradeCount}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding TradeDataWarning}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="4,8,4,10" />
                            <DataGrid ItemsSource="{Binding TradeRows}" Height="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="約定日" Binding="{Binding TradeDate}" Width="100" />
                                    <DataGridTextColumn Header="受渡日" Binding="{Binding SettlementDate}" Width="100" />
                                    <DataGridTextColumn Header="証券会社" Binding="{Binding Broker}" Width="110" />
                                    <DataGridTextColumn Header="口座区分" Binding="{Binding AccountType}" Width="130" />
                                    <DataGridTextColumn Header="取引種別" Binding="{Binding TradeType}" Width="100" />
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="90" />
                                    <DataGridTextColumn Header="単価" Binding="{Binding UnitPrice}" Width="120" />
                                    <DataGridTextColumn Header="通貨" Binding="{Binding Currency}" Width="70" />
                                    <DataGridTextColumn Header="為替" Binding="{Binding ExchangeRate}" Width="80" />
                                    <DataGridTextColumn Header="円換算額" Binding="{Binding SettlementAmountJpy}" Width="130" />
                                    <DataGridTextColumn Header="手数料" Binding="{Binding FeeJpy}" Width="110" />
                                    <DataGridTextColumn Header="税金" Binding="{Binding TaxJpy}" Width="110" />
                                    <DataGridTextColumn Header="実現損益" Binding="{Binding RealizedGainLossJpy}" Width="130" />
                                    <DataGridTextColumn Header="取引後数量" Binding="{Binding AfterTradeQuantity}" Width="110" />
                                    <DataGridTextColumn Header="取引後平均" Binding="{Binding AfterTradeAverageCost}" Width="130" />
                                    <DataGridTextColumn Header="データ元" Binding="{Binding Source}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="変更・企業行動">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,16,4,4">
                            <TextBlock Text="手動変更の履歴" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="保存前の確認内容・変更理由・記録時の評価額差です。過去の変更は削除されません。"
                                       TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" Margin="4,4,4,8" />
                            <DataGrid ItemsSource="{Binding ManualChangeRows}"
                                      SelectedItem="{Binding SelectedManualChange, Mode=TwoWay}"
                                      Height="240" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                    <DataGridTextColumn Header="記録日時" Binding="{Binding RecordedAt}" Width="145" />
                                    <DataGridTextColumn Header="理由" Binding="{Binding Reason}" Width="190" />
                                    <DataGridTextColumn Header="変更前" Binding="{Binding Before}" Width="*" />
                                    <DataGridTextColumn Header="変更後" Binding="{Binding After}" Width="*" />
                                    <DataGridTextColumn Header="確定原価差" Binding="{Binding ConfirmedCostChange}" Width="120" />
                                    <DataGridTextColumn Header="評価額差" Binding="{Binding MarketValueChange}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="4,8,4,0">
                                <TextBox Text="{Binding RevertReason, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}" Width="360"
                                         ToolTip="再調整する理由を入力" />
                                <Button Content="選択した変更を再調整" Command="{Binding RevertManualChangeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ManualChangeMessage}" Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap" Margin="4,4,4,8" />
                            <TextBlock Text="移管・企業行動の専用台帳" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,0" />
                            <TextBlock Text="開始残高と根拠が揃わない期間の口座別残高は確定できません。CSVの無償入庫は分割候補または移管要確認として扱います。"
                                       TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" Margin="4,4,4,8" />
                            <Expander Header="移管・分割などを根拠付きで記録" Margin="4,0,4,12">
                                <StackPanel Margin="12">
                                    <TextBlock Text="{Binding ActionCorrectionLabel}" Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="複数口座を集約した表示では登録できません。対象口座を開いてから入力してください。開始残高の時点より前は再現できません。"
                                               TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <StackPanel Width="160">
                                            <TextBlock Text="発生日" Style="{StaticResource LabelTextStyle}" />
                                            <DatePicker SelectedDate="{Binding ActionDate, Mode=TwoWay}" Margin="0,0,12,8" />
                                        </StackPanel>
                                        <StackPanel Width="175">
                                            <TextBlock Text="種別" Style="{StaticResource LabelTextStyle}" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActionKind, Mode=TwoWay}" Margin="0,0,12,8">
                                                <ComboBoxItem Content="開始残高" Tag="OpeningBalance" />
                                                <ComboBoxItem Content="口座移管" Tag="Transfer" />
                                                <ComboBoxItem Content="分割・併合" Tag="StockSplit" />
                                                <ComboBoxItem Content="銘柄コード変更" Tag="TickerChange" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Width="165">
                                            <TextBlock Text="確認状態" Style="{StaticResource LabelTextStyle}" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActionStatus, Mode=TwoWay}" Margin="0,0,12,8">
                                                <ComboBoxItem Content="要確認" Tag="Pending" />
                                                <ComboBoxItem Content="根拠確認済み" Tag="Confirmed" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Width="165">
                                            <TextBlock Text="数量（分割は分割前）" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Width="165">
                                            <TextBlock Text="分割比率" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionSplitRatio, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Width="180">
                                            <TextBlock Text="引継原価（円・不明は空欄）" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionCarriedCostJpy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Width="205">
                                            <TextBlock Text="元証券会社" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionSourceBroker, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Width="170">
                                            <TextBlock Text="元口座" Style="{StaticResource LabelTextStyle}" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActionSourceAccount, Mode=TwoWay}" Margin="0,0,12,8">
                                                <ComboBoxItem Content="不明" Tag="Unknown" /><ComboBoxItem Content="特定" Tag="Specific" />
                                                <ComboBoxItem Content="一般" Tag="General" /><ComboBoxItem Content="NISA成長" Tag="NisaGrowth" />
                                                <ComboBoxItem Content="NISA積立" Tag="NisaAccumulation" /><ComboBoxItem Content="旧NISA" Tag="NisaLegacy" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Width="205">
                                            <TextBlock Text="先証券会社" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionDestinationBroker, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Width="170">
                                            <TextBlock Text="先口座" Style="{StaticResource LabelTextStyle}" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActionDestinationAccount, Mode=TwoWay}" Margin="0,0,12,8">
                                                <ComboBoxItem Content="不明" Tag="Unknown" /><ComboBoxItem Content="特定" Tag="Specific" />
                                                <ComboBoxItem Content="一般" Tag="General" /><ComboBoxItem Content="NISA成長" Tag="NisaGrowth" />
                                                <ComboBoxItem Content="NISA積立" Tag="NisaAccumulation" /><ComboBoxItem Content="旧NISA" Tag="NisaLegacy" />
                                            </ComboBox>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Width="190">
                                            <TextBlock Text="旧コード（銘柄変更時）" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionOldTicker, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Width="190">
                                            <TextBlock Text="新コード（銘柄変更時）" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionNewTicker, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Width="330">
                                            <TextBlock Text="根拠（確認済みでは必須）" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionEvidence, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Width="220">
                                            <TextBlock Text="メモ・保留理由" Style="{StaticResource LabelTextStyle}" />
                                            <TextBox Text="{Binding ActionReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="台帳に記録" Command="{Binding SaveCorporateActionCommand}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        <Button Content="下表の選択行を訂正" Command="{Binding LoadCorporateActionCorrectionCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CorporateActionMessage}" Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>
                            <DataGrid ItemsSource="{Binding CorporateActionRows}"
                                      SelectedItem="{Binding SelectedCorporateAction, Mode=TwoWay}"
                                      Height="240" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                    <DataGridTextColumn Header="発生日" Binding="{Binding EventDate}" Width="105" />
                                    <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="130" />
                                    <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="元口座" Binding="{Binding Source}" Width="170" />
                                    <DataGridTextColumn Header="先口座" Binding="{Binding Destination}" Width="170" />
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="100" />
                                    <DataGridTextColumn Header="引継原価" Binding="{Binding CarriedCost}" Width="120" />
                                    <DataGridTextColumn Header="根拠" Binding="{Binding Evidence}" Width="*" />
                                    <DataGridTextColumn Header="メモ・訂正元" Binding="{Binding Reason}" Width="190" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="口座別の時点残高" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="4,0,4,8">
                                <DatePicker SelectedDate="{Binding HistoricalBalanceDate, Mode=TwoWay}" Width="150" />
                                <Button Content="指定日の残高を再計算" Command="{Binding RefreshHistoricalBalanceCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding HistoricalBalanceStatus}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" Margin="4,0,4,8" />
                            <DataGrid ItemsSource="{Binding HistoricalBalanceRows}" Height="180" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="証券会社" Binding="{Binding Broker}" Width="*" />
                                    <DataGridTextColumn Header="口座" Binding="{Binding Account}" Width="*" />
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="120" />
                                    <DataGridTextColumn Header="引継原価" Binding="{Binding CostJpy}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="データ情報">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,16,4,4">
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="株価取得元" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding CurrentPriceSource}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentPriceAcquiredAt}" Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="配当情報取得元" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding DividendInfoSource}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DividendInfoAcquiredAt}" Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="異常値候補と確認履歴" Style="{StaticResource SectionTitleStyle}" Margin="4,12,4,8" />
                            <TextBlock Text="株価・通貨・取引の異常候補と根拠を表示します。取引データは自動修正しません。株価急変は確認後に再取得できます。通貨不一致は登録・取得元の修正が必要です。"
                                       Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="4,0,4,8" />
                            <DataGrid ItemsSource="{Binding MarketAnomalyRows}" SelectedItem="{Binding SelectedMarketAnomaly, Mode=TwoWay}"
                                      Height="190" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="検知日時" Binding="{Binding ObservedAt}" Width="140" />
                                    <DataGridTextColumn Header="種類" Binding="{Binding Category}" Width="110" />
                                    <DataGridTextColumn Header="前回 → 今回" Binding="{Binding Difference}" Width="140" />
                                    <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="130" />
                                    <DataGridTextColumn Header="根拠" Binding="{Binding Evidence}" Width="*" />
                                    <DataGridTextColumn Header="確認事項" Binding="{Binding SuggestedCheck}" Width="220" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="選択した候補の判断履歴" Style="{StaticResource SubtleTextStyle}" Margin="4,8,4,3" />
                            <ItemsControl ItemsSource="{Binding MarketAnomalyDecisionRows}" Margin="8,0,4,8" />
                            <TextBox Text="{Binding MarketAnomalyReason, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="確認した根拠と判断理由を入力してください" Margin="4,0,4,6" />
                            <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
                                <Button Content="異常として保留" Command="{Binding ConfirmMarketAnomalyCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="確認済み・候補を除外" Command="{Binding AcceptMarketAnomalyCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="この銘柄を再取得" Command="{Binding DataContext.RefreshDetailMarketDataCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MarketAnomalyMessage}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="4,0,4,8" />
                            <TextBlock Text="項目別データ品質" Style="{StaticResource SectionTitleStyle}" Margin="4,12,4,8" />
                            <DataGrid ItemsSource="{Binding DataQualityRows}" Height="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="項目" Binding="{Binding FieldName}" Width="160" />
                                    <DataGridTextColumn Header="値" Binding="{Binding Value}" Width="150" />
                                    <DataGridTextColumn Header="取得元種別" Binding="{Binding SourceType}" Width="130" />
                                    <DataGridTextColumn Header="取得元" Binding="{Binding SourceName}" Width="180" />
                                    <DataGridTextColumn Header="取得日時" Binding="{Binding RetrievedAt}" Width="150" />
                                      <DataGridTextColumn Header="確からしさ" Binding="{Binding Confidence}" Width="110" />
                                      <DataGridTextColumn Header="鮮度" Binding="{Binding Freshness}" Width="100" />
                                    <DataGridTextColumn Header="メモ" Binding="{Binding Memo}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
