<UserControl x:Class="InvestmentStory.App.Views.CsvReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="再読込" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="CSV取込を開く" Command="{Binding OpenImportCommand}" Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>
                <TextBlock Text="保存済みCSV要確認記録" Style="{StaticResource SectionTitleStyle}" />
            </DockPanel>
            <TextBlock Text="元CSVの要確認行を表示します。取引の解決は取込画面で行い、保有・配当の履歴は根拠を記して確認します。"
                       Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <DataGrid x:Name="ReviewGrid" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="区分" Binding="{Binding Category}" Width="140" />
                <DataGridTextColumn Header="日付" Binding="{Binding Date}" Width="115" />
                <DataGridTextColumn Header="銘柄" Binding="{Binding Security}" Width="150" />
                <DataGridTextColumn Header="証券会社" Binding="{Binding Broker}" Width="130" />
                <DataGridTextColumn Header="口座" Binding="{Binding Account}" Width="110" />
                <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="115" />
                <DataGridTextColumn Header="確認理由" Binding="{Binding Reason}" Width="*" MinWidth="220" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Style="{StaticResource MetricCardStyle}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding SelectedDetail}" TextWrapping="Wrap" />
                <TextBox Text="{Binding ReviewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="1000" MinHeight="35" Margin="0,10,0,8" IsEnabled="{Binding CanReview}"
                         ToolTip="保留・確認済みにする理由を入力" />
                <WrapPanel>
                    <Button Content="保留にする" Command="{Binding HoldCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="確認済みにする" Command="{Binding ConfirmCommand}" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="要確認に戻す" Command="{Binding ReopenCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
