<UserControl x:Class="InvestmentStory.App.Views.NisaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="NISA評価額と投資枠" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="保有時価と制度上の枠使用量は別の値です。旧NISAは新制度の投資枠計算から除外します。"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,12" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding AsOfLabel}" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="{Binding Valuation}" FontSize="20" Margin="0,6" />
                    <TextBlock Text="{Binding EvidenceCoverage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <TextBlock Text="{Binding AnnualUse}" FontSize="16" Margin="0,5" />
                    <TextBlock Text="{Binding Remaining}" FontSize="16" Margin="0,5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding RuleSource}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="新NISA取得・売却履歴" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="買付は決済円額、売却は売却分の取得簿価を入力してください。評価額や売却代金を入れると残枠が誤ります。"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,10" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="取引日" /><DatePicker SelectedDate="{Binding EntryDate}" Width="140" /></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="枠" /><ComboBox ItemsSource="{Binding Frames}" SelectedItem="{Binding Frame}" Width="160" /></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="区分" /><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="160" /></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="取得簿価（円）" /><TextBox Text="{Binding BookCost, UpdateSourceTrigger=PropertyChanged}" Width="150" /></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="出所" /><TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="160" /></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="根拠" /><TextBox Text="{Binding Evidence, UpdateSourceTrigger=PropertyChanged}" Width="220" /></StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <Button Content="履歴を追加" Command="{Binding SaveCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="選択した履歴を削除" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Transactions}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付" Binding="{Binding Date}" Width="110" />
                            <DataGridTextColumn Header="枠" Binding="{Binding Frame}" Width="145" />
                            <DataGridTextColumn Header="区分" Binding="{Binding Kind}" Width="70" />
                            <DataGridTextColumn Header="取得簿価" Binding="{Binding BookCostJpy}" Width="115" />
                            <DataGridTextColumn Header="出所" Binding="{Binding Source}" Width="145" />
                            <DataGridTextColumn Header="根拠" Binding="{Binding Evidence}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="2024年から基準日まで、全証券会社の買付と売却を照合した場合だけ確認状態を記録してください。追加・削除すると再確認が必要です。"
                               TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,12,0,5" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding HistoryEvidence, UpdateSourceTrigger=PropertyChanged}" Width="420" Margin="0,0,8,0" />
                        <Button Content="基準日までの履歴を確認済みにする" Command="{Binding ConfirmHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
