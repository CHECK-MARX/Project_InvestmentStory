<UserControl x:Class="InvestmentStory.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:InvestmentStory.App.Controls">
    <UserControl.Resources>
        <Style x:Key="CashDashboardCellStyle" TargetType="TextBlock" BasedOn="{StaticResource DataGridCellTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="4,6" />
        </Style>
        <Style x:Key="CashDashboardStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource CashDashboardCellStyle}">
            <Setter Property="ToolTip" Value="{Binding Evidence}" />
        </Style>
        <Style x:Key="DashboardGainValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPositiveGain}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ProfitBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNegativeGain}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LossBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReturnValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPositiveReturn}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ProfitBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNegativeReturn}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LossBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="投資ダッシュボード" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding MarketDataStatus}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                    <TextBlock Text="{Binding DataUpdateStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DataCoverageStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MarketRefreshStatus}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="失敗した株価のみ再試行" Command="{Binding DataContext.RetryFailedMarketDataCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="為替・画面を再読込" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayReviewDate}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="通知を開く" Command="{Binding DataContext.ShowRemindersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="今日の確認" Style="{StaticResource SectionTitleStyle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding TodayReviewScope}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding TodayReviewCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0}件}" FontWeight="SemiBold" FontSize="17" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,3" />
                                        <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" />
                                        <Expander Header="対象の記録を選ぶ" Margin="0,8,0,0"
                                                  Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Label}" ToolTip="{Binding Context}"
                                                                    Command="{Binding DataContext.OpenReviewItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2,0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Expander>
                                        <Button Content="{Binding NextAction}"
                                                Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Kind}" Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBlueBrush}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="保有株・投信の評価額" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock Text="{Binding TotalCurrentMarketValue}" Style="{StaticResource MetricValueTextStyle}" />
                            <TextBlock Text="現在評価額合計" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPositiveGain}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ProfitBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasNegativeGain}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource LossBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding UnrealizedGainLabel}" Style="{StaticResource LabelTextStyle}" ToolTip="{Binding ReferencePurchaseCostNote}" />
                            <TextBlock Text="{Binding TotalUnrealizedGain}" Style="{StaticResource DashboardGainValueStyle}" />
                            <TextBlock Text="{Binding TotalUnrealizedGainRate}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UnrealizedGainRateExplanation}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource DividendBrush}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="今年の配当実績" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock Text="{Binding ThisYearPassiveIncome}" Style="{StaticResource MetricValueTextStyle}" />
                            <TextBlock Text="税引後入金ベース" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="年間目標達成率" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock Text="{Binding AnnualGoalAchievementRate}" Style="{StaticResource MetricValueTextStyle}" Foreground="{DynamicResource WarningBrush}" />
                            <ProgressBar Value="{Binding AnnualGoalProgressValue, Mode=OneWay}" Maximum="100" Height="7" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="現金台帳を開く"
                                Command="{Binding DataContext.ShowCashLedgerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock Text="現金を含む資産の確認" Style="{StaticResource SectionTitleStyle}" />
                    </DockPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="現金残高（登録口座分・参考換算）" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RegisteredCashTotal}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="株・投信＋現金（登録分の参考合計）" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SecuritiesAndRegisteredCashTotal}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding CashCoverageStatus}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding KnownCashSubtotal}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="{Binding CashTotalScopeNote}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Expander Header="口座・通貨別の基準日と集計できない理由" Margin="0,8,0,0">
                        <DataGrid ItemsSource="{Binding CashBalances}" Height="240" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="NaN" MinRowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="口座" Binding="{Binding Account}" Width="150" ElementStyle="{StaticResource CashDashboardCellStyle}" />
                                <DataGridTextColumn Header="通貨" Binding="{Binding Currency}" Width="65" />
                                <DataGridTextColumn Header="残高基準日" Binding="{Binding BalanceDate}" Width="110" />
                                <DataGridTextColumn Header="期末明細の残高" Binding="{Binding StatementBalance}" Width="130" ElementStyle="{StaticResource CashDashboardCellStyle}" />
                                <DataGridTextColumn Header="集計対象の円額" Binding="{Binding IncludedJpy}" Width="130" ElementStyle="{StaticResource CashDashboardCellStyle}" />
                                <DataGridTextColumn Header="状態・換算根拠" Binding="{Binding Status}" Width="*" MinWidth="180" ElementStyle="{StaticResource CashDashboardStatusStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock Text="NISA口座サマリー" Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,8" />
            <ItemsControl ItemsSource="{Binding NisaSummaries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource DividendBrush}" CornerRadius="3" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding PositionCountText}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,12" />

                                    <StackPanel>
                                        <TextBlock Text="評価額" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{Binding MarketValueJpy}" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="取得額" Style="{StaticResource LabelTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding PurchaseAmountJpy}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="評価損益" Style="{StaticResource LabelTextStyle}" />
                                            <TextBlock Text="{Binding GainLossJpy}" FontSize="20" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPositiveGain}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ProfitBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasNegativeGain}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource LossBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="評価損益率" Style="{StaticResource LabelTextStyle}" />
                                            <TextBlock Text="{Binding GainLossRate}" FontSize="18" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPositiveGain}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ProfitBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasNegativeGain}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource LossBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="年間配当見込み" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding AnnualPassiveIncomeForecast}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                        <TextBlock Text="月平均" Style="{StaticResource LabelTextStyle}" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding MonthlyAveragePassiveIncomeForecast}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="目標まで" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding AnnualGoalGap}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="月10万円まで" Style="{StaticResource LabelTextStyle}" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding Monthly100kGap}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalReturnLabel}" Style="{StaticResource LabelTextStyle}" ToolTip="{Binding ReferencePurchaseCostNote}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TotalReturn}" Style="{StaticResource DashboardReturnValueStyle}" />
                        <TextBlock Text="{Binding TotalReturnExplanation}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PeriodReturnAvailability}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                        <Button Content="運用成績を確認" Command="{Binding DataContext.ShowPerformanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="累計受取配当" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding CumulativeDividend}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource DividendBrush}" />
                        <TextBlock Text="確認済みの受取配当" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="前日比 / 前月比" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding TotalAssetDayChange}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalAssetMonthChange}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="上位5銘柄集中率" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding Top5ConcentrationRate}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding CapitalRecoveryAvailability}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="現在値を記録" Command="{Binding RecordSnapshotCommand}" Style="{StaticResource ActionButtonStyle}" />
                            <ComboBox DockPanel.Dock="Right"
                                      ItemsSource="{Binding HistoryPeriods}"
                                      SelectedItem="{Binding SelectedHistoryPeriod, Mode=TwoWay}"
                                      Width="120"
                                      Margin="0,0,10,0" />
                            <TextBlock Text="資産推移（株・投信）" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding RecordSnapshotStatus}" Foreground="{DynamicResource WarningBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border MinHeight="220" Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="記録点にカーソルを合わせると、その日の金額を確認できます。この推移は株・投信のみで、現金残高は含みません。"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="22" Height="3" Background="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="株・投信の評価額" Margin="6,0,18,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Border Width="22" Height="3" Background="{DynamicResource DividendBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="投資元本" Margin="6,0,18,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Border Width="22" Height="3" Background="{DynamicResource ProfitBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="含み損益" Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PortfolioHistoryMessage}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <controls:PortfolioHistoryLineChartControl Items="{Binding PortfolioHistoryRows}"
                                                                           Height="320" AutomationProperties.Name="資産推移の折れ線グラフ" />
                                <TextBlock Text="グラフをクリック後、左右キーで記録日を選択できます。" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" />
                                <Expander Header="資産推移の数値を表で確認" Margin="0,8,0,0">
                                    <DataGrid ItemsSource="{Binding PortfolioHistoryRows}" Height="220" IsReadOnly="True" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="日付" Binding="{Binding Date}" Width="105" />
                                            <DataGridTextColumn Header="評価額" Binding="{Binding TotalMarketValue}" Width="*" />
                                            <DataGridTextColumn Header="投資元本" Binding="{Binding TotalCostBasis}" Width="*" />
                                            <DataGridTextColumn Header="含み損益" Binding="{Binding UnrealizedGainLoss}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox DockPanel.Dock="Right"
                                      ItemsSource="{Binding CompositionModes}"
                                      SelectedItem="{Binding SelectedCompositionMode, Mode=TwoWay}"
                                      Width="130" />
                            <TextBlock Text="資産構成（株・投信）" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Border MinHeight="220" Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CompositionTotal}" FontWeight="SemiBold" FontSize="17" />
                                    <TextBlock Text="評価額の内訳" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding CompositionSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding CompositionBasisNote}" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <ScrollViewer Height="338" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding CompositionCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="8"
                                                        Padding="9" Margin="0,0,4,8">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}"
                                                                       FontWeight="SemiBold" FontSize="12" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="4" Height="16" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,0,7,0" />
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <DockPanel Margin="11,4,0,4">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}"
                                                                       Foreground="{Binding AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                                                            <TextBlock Text="{Binding HoldingCountText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                                        </DockPanel>
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding SharePercent, Mode=OneWay}"
                                                                     Foreground="{Binding AccentBrush}" Height="6" Margin="0,0,0,3" />
                                                        <Expander Header="銘柄内訳" Foreground="{DynamicResource SecondaryTextBrush}"
                                                                  FontSize="11" Margin="0,2,0,0">
                                                            <ItemsControl ItemsSource="{Binding Holdings}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="6,3,0,0">
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontSize="11"
                                                                                       FontWeight="SemiBold" Margin="6,0,0,0" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                       ToolTip="{Binding Label}" />
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource MetricCardStyle}" Margin="0,8,0,0">
                <Expander Header="月末記録と再集計差を確認">
                    <StackPanel>
                        <TextBlock Text="月末に記録した銘柄別・口座別の値と根拠を保存します。翌日以降に固定し、後から上書きしません。再集計は保存時の明細に現行の集計規則を適用した値で、現在の株価による過去日の評価ではありません。"
                                   Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding MonthEndStatus}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding HasMonthEndRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid ItemsSource="{Binding MonthEndRows}" SelectedItem="{Binding SelectedMonthEnd, Mode=TwoWay}"
                                      IsReadOnly="True" AutoGenerateColumns="False" Height="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="月末日" Binding="{Binding Date}" Width="100" />
                                    <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="当時保存値" Binding="{Binding SavedTotal}" Width="*" />
                                    <DataGridTextColumn Header="現行算式で再集計" Binding="{Binding RecalculatedTotal}" Width="*" />
                                    <DataGridTextColumn Header="差" Binding="{Binding Difference}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding SelectedMonthEnd.DifferenceReason}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,8,0,3" />
                            <TextBlock Text="{Binding SelectedMonthEnd.Formula}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedMonthEnd.Quality}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedMonthEnd.FxBasis}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding SelectedMonthEnd.PositionRows}" IsReadOnly="True" AutoGenerateColumns="False" Height="180" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="銘柄" Binding="{Binding Ticker}" Width="80" />
                                    <DataGridTextColumn Header="口座" Binding="{Binding Account}" Width="130" />
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="90" />
                                    <DataGridTextColumn Header="当時評価額" Binding="{Binding MarketValue}" Width="110" />
                                    <DataGridTextColumn Header="取得額" Binding="{Binding Cost}" Width="100" />
                                    <DataGridTextColumn Header="品質" Binding="{Binding Quality}" Width="90" />
                                    <DataGridTextColumn Header="取得額根拠" Binding="{Binding CostEvidence}" Width="180" />
                                    <DataGridTextColumn Header="価格根拠" Binding="{Binding PriceEvidence}" Width="180" />
                                    <DataGridTextColumn Header="為替根拠" Binding="{Binding FxEvidence}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid ItemsSource="{Binding SelectedMonthEnd.CashRows}" IsReadOnly="True" AutoGenerateColumns="False" Height="100" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="現金口座" Binding="{Binding Account}" Width="130" />
                                    <DataGridTextColumn Header="通貨" Binding="{Binding Currency}" Width="70" />
                                    <DataGridTextColumn Header="円換算残高" Binding="{Binding Amount}" Width="110" />
                                    <DataGridTextColumn Header="残高・換算根拠" Binding="{Binding Basis}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="為替感応度" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="USD/JPYが変動した場合の保有株・投信評価額への影響です。外貨建て資産のみを対象に概算します。"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding FxSensitivityRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6" ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RateDelta}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding UsdJpyRate}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Grid Grid.Column="2" Height="14" Background="{DynamicResource ElevatedSurfaceBrush}" VerticalAlignment="Center">
                                        <Border Width="{Binding BarWidth}" Background="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Left" CornerRadius="7" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding ChangeFromCurrent}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="{Binding TotalMarketValue}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
